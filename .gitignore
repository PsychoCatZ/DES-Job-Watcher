.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
tmp/
data/
logs/

# Личные исходные резюме не публикуются вместе с кодом.
/*.pdf

# Личные профили и история резюме остаются только на машине владельца.
/config/profiles/

# Первоначальные заметки содержат личные кейсы; открытые уроки — отдельно.
/docs/*
!/docs/lessons/
!/docs/PUBLICATION.md

# Локальные ключи, сертификаты, базы и служебные файлы.
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
.DS_Store
.idea/
.vscode/
